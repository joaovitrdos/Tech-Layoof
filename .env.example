# Copie para .env e preencha. O .env real nunca vai para o git.
# So entra aqui o que e segredo ou o que muda de um ambiente para outro.
# Politica fixa da aplicacao (rate limit, tamanho de imagem, cron da coleta,
# modelo da OpenAI) fica no application.properties, versionada e revisada em PR.
# Gere segredos com: openssl rand -base64 48

# BANCO DE DADOS
DB_URL=jdbc:postgresql://localhost:5432/layoof
DB_USERNAME=
DB_PASSWORD=
# update em desenvolvimento; em producao use validate e aplique o schema por migracao.
# Sem esta chave a aplicacao assume validate, que nao altera o schema.
JPA_DDL_AUTO=update

# REDIS
# Vazio = Redis local sem autenticacao. Preencha antes de subir em docker:
# o compose recusa iniciar o redis sem senha.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
# Minimo 32 caracteres; a aplicacao recusa subir com segredo fraco.
LAYOOF_JWT_SECRET=

# E-MAIL (SMTP)
# No Gmail use uma senha de app, nao a senha da conta.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
MAIL_FROM=
MAIL_ENABLED=true

# GOOGLE OAUTH
# So o client id: o backend valida o ID token, nao usa client secret.
GOOGLE_CLIENT_ID=

# IA (Spring AI + OpenAI)
# Chave em https://platform.openai.com/api-keys
# Para subir sem nenhuma IA: chave vazia e AI_CHAT_MODEL=none.
AI_ENABLED=true
AI_CHAT_MODEL=openai
AI_CHAT_GPT_API_KEY=

# COLETA AGENDADA
# Cada execucao consome creditos da OpenAI. Deixe false se nao quiser coleta automatica.
INGESTION_ENABLED=true

# SEGURANCA
# Origens do front separadas por virgula. Sem curinga: so o que estiver aqui passa no CORS.
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Swagger fica fora do ar por padrao. Ligue so em desenvolvimento.
DOCS_ENABLED=false

# ARMAZENAMENTO DE IMAGENS
# local = grava em disco e serve em /files (padrao de desenvolvimento). r2 = Cloudflare R2.
STORAGE_PROVIDER=local
# Com provider=local aponte para a propria API. Com r2, use o dominio publico do bucket
# (r2.dev ou seu dominio na Cloudflare), sem barra no final.
STORAGE_PUBLIC_URL=http://localhost:8080/files
STORAGE_LOCAL_DIR=uploads
# Cloudflare R2 (Dashboard > R2 > Manage API Tokens). Deixe vazio com provider=local.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
