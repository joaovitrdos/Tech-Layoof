# Gere cada segredo deste arquivo com:  openssl rand -base64 48
# Nunca reaproveite segredos entre ambientes e nunca versione o .env real.

# DB
DB_URL=jdbc:postgresql://localhost:5432/layoof
DB_USERNAME=
DB_PASSWORD=
# Em producao use validate e aplique o schema por migracao.
JPA_DDL_AUTO=update

# JWT (minimo 32 caracteres; a aplicacao recusa subir com segredo fraco)
LAYOOF_JWT_SECRET=

# Google OAuth
GOOGLE_CLIENT_ID=

# E-mail (SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=@gmail.com
MAIL_PASSWORD=
MAIL_FROM=@gmail.com
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
MAIL_ENABLED=true

# IA (OpenAI: https://platform.openai.com/api-keys)
# A chave e obrigatoria: sem ela a aplicacao nao arranca.
# Para subir sem nenhuma IA, deixe a chave vazia e ponha AI_CHAT_MODEL=none.
AI_CHAT_GPT_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
AI_ENABLED=true
# Use none para subir a aplicacao sem nenhum modelo de IA.
AI_CHAT_MODEL=openai

# SEGURANCA
# Origens do front separadas por virgula. Sem curinga: so o que estiver aqui passa no CORS.
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Swagger fica fora do ar por padrao. Ligue so em desenvolvimento.
DOCS_ENABLED=false
RATE_LIMIT_ENABLED=true
# So ligue com um proxy reverso confiavel na frente, senao o X-Forwarded-For e falsificavel.
TRUST_PROXY=false
